# Downstream Hub — copy to .env and adjust for local dev
# For Docker: docker compose reads .env by default.

# ---------- Database (Postgres) ----------
POSTGRES_USER=hub
POSTGRES_PASSWORD=hubsecret
POSTGRES_DB=downstream_hub
# Use 5433 if local PostgreSQL is already on 5432 (e.g. for pgAdmin to reach Docker DB)
POSTGRES_PORT=5433

# ---------- Redis ----------
REDIS_PORT=6379

# ---------- Backend API ----------
NODE_ENV=development
API_PORT=4000
PORT=4000

# Backend uses DATABASE_URL and REDIS_URL from docker-compose when running in Docker.
# For running backend outside Docker (e.g. local node), set:
# DATABASE_URL=postgresql://hub:hubsecret@localhost:5432/downstream_hub
# REDIS_URL=redis://localhost:6379

# ---------- Auth / SSO (secrets — change in production) ----------
JWT_SECRET=your-jwt-secret-change-in-production
JWT_EXPIRES_IN=7d
# Rate limiting: login (default 20/15min), register (default 5/15min). Set TRUST_PROXY=1 behind reverse proxy.
# RATE_LIMIT_LOGIN_MAX=20
# RATE_LIMIT_LOGIN_WINDOW_MS=900000
# RATE_LIMIT_REGISTER_MAX=5
# RATE_LIMIT_REGISTER_WINDOW_MS=900000
# Forgot password (default 5 per 15 min per IP+email)
# RATE_LIMIT_FORGOT_PASSWORD_MAX=5
# RATE_LIMIT_FORGOT_PASSWORD_WINDOW_MS=900000
# TRUST_PROXY=1
SSO_TOKEN_SECRET=your-sso-shared-secret-change-in-production
SSO_TOKEN_EXPIRY_SECONDS=60
# Public URL of the API (for SSO bridge redirect). Default: http://localhost:4000
# API_PUBLIC_URL=http://localhost:4000

# Public URL of the Hub SPA (password reset links: {PUBLIC_APP_URL}/reset-password?token=...)
# Use a free host port; 3100 avoids conflict with other local apps on 3000 (e.g. Jetty Planning System).
# PUBLIC_APP_URL=http://localhost:3100
# PASSWORD_RESET_TTL_MINUTES=30

# SMTP (optional — if unset, reset links are logged to server console in development)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=noreply@example.com

# ---------- Frontend (build-time / runtime) ----------
FRONTEND_PORT=3100
VITE_API_URL=http://localhost:4000
# Same origin users use in the browser (for documentation; reset emails use PUBLIC_APP_URL on the server)
# VITE_PUBLIC_APP_URL=http://localhost:3100

# ---------- Logging (optional, see technical-architecture.md §8) ----------
# LOG_LEVEL=debug
# STDOUT_ONLY=true
